// Prisma-Schema — Mini-Musik-DB der Lessons KM5-03/KM5-04 (Label, Kuenstler, Song).
// Tabellenname = Modellname, Spaltenname = TypeScript-Name (Prisma-Standard),
// deshalb schreibt das rohe SQL in $queryRaw "Song"."dauerSek" statt dauer_sek.
generator client {
  provider = "prisma-client" // TypeScript-Client, NICHT prisma-client-js (CommonJS, bricht unter ESM)
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Label {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  kuenstler Kuenstler[]
}

model Kuenstler {
  id      Int     @id @default(autoincrement())
  name    String
  labelId Int? // NULL erlaubt -> "Independent" (Frei)
  label   Label? @relation(fields: [labelId], references: [id])
  songs   Song[]
}

model Song {
  id          Int      @id @default(autoincrement())
  titel       String
  dauerSek    Int
  kuenstlerId Int
  kuenstler   Kuenstler @relation(fields: [kuenstlerId], references: [id])
}
