// Prisma-Schema — Musik-Streaming-DB (Mini-Ausschnitt, KM5-01)
generator client {
  provider = "prisma-client"   // TypeScript-Client, NICHT prisma-client-js (CommonJS, bricht unter ESM)
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Label {
  id        Int         @id @default(autoincrement())
  name      String      @unique
  kuenstler Kuenstler[]
}

model Kuenstler {
  id      Int     @id @default(autoincrement())
  name    String
  labelId Int?            // NULL erlaubt -> "ohne Label"
  label   Label? @relation(fields: [labelId], references: [id])
  songs   Song[]
}

model Song {
  id          Int      @id @default(autoincrement())
  titel       String
  dauerSek    Int
  kuenstlerId Int
  kuenstler   Kuenstler @relation(fields: [kuenstlerId], references: [id])
  playlists   Playlist[]
}

model Playlist {
  id    Int    @id @default(autoincrement())
  name  String @unique
  songs Song[] // N:M -> Prisma legt die implizite Tabelle _PlaylistToSong an
}
