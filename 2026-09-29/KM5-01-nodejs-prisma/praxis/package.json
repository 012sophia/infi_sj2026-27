{
  "name": "km5-01-nodejs-prisma-praxis",
  "version": "1.0.0",
  "description": "Praxis-Scaffold KM5-01: Node.js + Prisma 7 + SQLite (TypeScript-Client)",
  "main": "index.js",
  "scripts": {
    "test": "node --import tsx --test test/queries.test.ts",
    "run": "tsx src/queries.ts",
    "playlist": "tsx src/playlist.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx src/seed.ts",
    "db:status": "prisma migrate status",
    "db:reset": "prisma migrate reset --force",
    "studio": "prisma studio --url file://./dev.db",
    "postinstall": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.5",
    "prisma": "^6.19.3"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true,
    "better-sqlite3@12.11.1": true,
    "prisma@7.10.0": true,
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15"
  }
}
